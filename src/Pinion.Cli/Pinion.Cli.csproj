<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>pinion</AssemblyName>
    <RootNamespace>Pinion.Cli</RootNamespace>

    <!-- Global tool packaging: `dotnet tool install -g Pinion` → `pinion ...` -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pinion</ToolCommandName>
    <PackageId>Pinion</PackageId>
    <Version>1.2.0</Version>
    <Authors>Alexander Gomnes</Authors>
    <Description>Lock what your legacy .NET code does today into runnable characterization tests, migrate with AI or by hand, then prove nothing changed. Offline by default - the analyze and deterministic generate paths make zero network calls, with no telemetry and no AI unless you opt in. Supports C# and VB.NET.</Description>
    <PackageTags>characterization-tests;pinning-tests;golden-master;approval-testing;snapshot-testing;legacy;legacy-modernization;migration;roslyn;csharp;vbnet;mutation-testing;dotnet-tool;testing</PackageTags>
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AGomnes/Pinion</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/AGomnes/Pinion</PackageProjectUrl>
    <PackageReleaseNotes>See https://github.com/AGomnes/Pinion/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <!-- Source-available: FSL-1.1-ALv2. Free for ALL use including commercial and internal; only
         Competing Use (reselling/rehosting Pinion itself) is withheld. Converts to Apache-2.0 two
         years after each release. Not an SPDX/OSI expression, so it ships as a file, not a string. -->
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\NUGET.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Analyze layer -->
    <ProjectReference Include="..\Pinion.Engine\Pinion.Engine.csproj" />
    <ProjectReference Include="..\Pinion.Adapters.CSharp\Pinion.Adapters.CSharp.csproj" />
    <ProjectReference Include="..\Pinion.Adapters.VisualBasic\Pinion.Adapters.VisualBasic.csproj" />
    <!-- Generate layer (the CLI is the composition root that bundles both) -->
    <ProjectReference Include="..\Pinion.Generate\Pinion.Generate.csproj" />
    <ProjectReference Include="..\Pinion.Adapters.CSharp.Generate\Pinion.Adapters.CSharp.Generate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.8" />
    <!-- MSBuild assemblies must come from the SDK that MSBuildLocator registers at
         runtime, never copied locally. Reference for compile only. -->
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
